#include <dt-bindings/clock/zhihe,a210-clk.h>
#include <dt-bindings/clock/zhihe,a210-aon-clk.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/reset/zhihe,a210-resets.h>

/ {
	compatible = "zhihe,a210";
	#address-cells = <2>;
	#size-cells = <2>;

	aon_rc: clock-aon-rc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
	};

	osc_24m: clock-osc-24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "osc-24m";
	};

	osc_32k: clock-osc-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "osc-32k";
	};

	aon_110m: clock-osc-110m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <110000000>;
		clock-output-names = "aon-110m";
	};

	rc_24m: clock-rc-24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "rc-24m";
	};

	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <24000000>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&c908_0>;
				};

				core1 {
					cpu = <&c908_1>;
				};

				core2 {
					cpu = <&c908_2>;
				};

				core3 {
					cpu = <&c908_3>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&c920_4>;
				};

				core1 {
					cpu = <&c920_5>;
				};

				core2 {
					cpu = <&c920_6>;
				};

				core3 {
					cpu = <&c920_7>;
				};
			};
		};

		c0_l2_cache: l2-cache0 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <512>;
			cache-size = <524288>;
			cache-unified;
		};

		c1_l2_cache: l2-cache1 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <1024>;
			cache-size = <1048576>;
			cache-unified;
		};

		c908_0: cpu@0 {
			device_type = "cpu";
			compatible = "thead,c908", "riscv";
			reg = <0>;
			clocks = <&clk C908_CPU_TO_CDE_CLK_MUX>;
			d-cache-block-size = <64>;
			d-cache-sets = <256>;
			d-cache-size = <32768>;
			i-cache-block-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <32768>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c0_l2_cache>;
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c908_1: cpu@1 {
			device_type = "cpu";
			compatible = "thead,c908", "riscv";
			reg = <1>;
			d-cache-block-size = <64>;
			d-cache-sets = <256>;
			d-cache-size = <32768>;
			i-cache-block-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <32768>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c0_l2_cache>;
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu1_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c908_2: cpu@2 {
			device_type = "cpu";
			compatible = "thead,c908", "riscv";
			reg = <2>;
			d-cache-block-size = <64>;
			d-cache-sets = <256>;
			d-cache-size = <32768>;
			i-cache-block-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <32768>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c0_l2_cache>;
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu2_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c908_3: cpu@3 {
			device_type = "cpu";
			compatible = "thead,c908", "riscv";
			reg = <3>;
			d-cache-block-size = <64>;
			d-cache-sets = <256>;
			d-cache-size = <32768>;
			i-cache-block-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <32768>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c0_l2_cache>;
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu3_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c920_4: cpu@4 {
			device_type = "cpu";
			compatible = "thead,c920", "riscv";
			reg = <4>;
			clocks = <&clk C920_CPU_TO_CDE_CLK_MUX>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <65536>;
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <65536>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c1_l2_cache>;
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu4_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c920_5: cpu@5 {
			device_type = "cpu";
			compatible = "thead,c920", "riscv";
			reg = <5>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <65536>;
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <65536>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c1_l2_cache>;
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu5_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c920_6: cpu@6 {
			device_type = "cpu";
			compatible = "thead,c920", "riscv";
			reg = <6>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <65536>;
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <65536>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c1_l2_cache>;
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu6_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c920_7: cpu@7 {
			device_type = "cpu";
			compatible = "thead,c920", "riscv";
			reg = <7>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <65536>;
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <65536>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c1_l2_cache>;
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu7_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};
	};

	power: power-controller {
		compatible = "zhihe,a210-power-domain";
		ranges;
		#address-cells = <2>;
		#power-domain-cells = <0>;
		#size-cells = <2>;

		power_top: power-domain-top {
			compatible = "zhihe,a210-pd-top";
			ranges;
			#address-cells = <2>;
			#power-domain-cells = <0>;
			#size-cells = <2>;

			ddr_ccu: clock-controller@5910000 {
				compatible = "zhihe,a210-ccu";
				reg = <0x00 0x05910000 0x0 0x2c>,
				      <0x00 0x05920000 0x0 0x2c>;
				zhihe,ccu-dly-time = <0x5e 0x5e>;
				zhihe,ccu-dly-time-step = <0x3 0x3>;
			};

			cpu_gating_ccu: clock-controller@10140000 {
				compatible = "zhihe,a210-ccu";
				reg = <0x00 0x10140000 0x0 0x2c>,
				      <0x00 0x10140200 0x0 0x2c>,
				      <0x00 0x10140400 0x0 0x2c>,
				      <0x00 0x10140600 0x0 0x2c>,
				      <0x00 0x10140a00 0x0 0x2c>,
				      <0x00 0x10140c00 0x0 0x2c>,
				      <0x00 0x10204000 0x0 0x2c>,
				      <0x00 0x10204200 0x0 0x2c>,
				      <0x00 0x10204400 0x0 0x2c>,
				      <0x00 0x10204600 0x0 0x2c>,
				      <0x00 0x10204800 0x0 0x2c>,
				      <0x00 0x10204a00 0x0 0x2c>,
				      <0x00 0x10205400 0x0 0x2c>;
				zhihe,ccu-dly-time = <0x34 0x34 0x34
						     0x34 0x34 0x34
						     0x34 0x34 0x34
						     0x34 0x34 0x34
						     0x34>;
				zhihe,ccu-dly-time-step = <0x2 0x2 0x2
							  0x2 0x2 0x2
							  0x2 0x2 0x2
							  0x2 0x2 0x2
							  0x2>;
			};

			cpu_scaling_ccu: clock-controller@10140800 {
				compatible = "zhihe,a210-ccu";
				reg = <0x00 0x10140800 0x0 0x2c>;
				zhihe,ccu-dly-time = <0x34>;
				zhihe,ccu-dly-time-step = <0x2>;
				zhihe,ccu-mode = <1>;
				zhihe,ccu-ratio = <63>;
			};

			tee_ccu: clock-controller@27430000 {
				compatible = "zhihe,a210-ccu";
				reg = <0x00 0x27430000 0x0 0x2c>;
				zhihe,ccu-dly-time = <0x5e>;
				zhihe,ccu-dly-time-step = <0x3>;
			};
		};
	};

	soc {
		compatible = "simple-bus";
		ranges;
		#address-cells = <2>;
		dma-noncoherent;
		#size-cells = <2>;

		clk: clock-controller@260000 {
			compatible = "zhihe,a210-clk";
			reg = <0x0 0x00260000 0x0 0x1000>,
			      <0x0 0x00250000 0x0 0x1000>,
			      <0x0 0x10141600 0x0 0x100>,
			      <0x0 0x10141400 0x0 0x100>,
			      <0x0 0x04810000 0x0 0x1000>,
			      <0x0 0x05810000 0x0 0x1000>,
			      <0x0 0x04900000 0x0 0x1000>,
			      <0x0 0x20250000 0x0 0x1000>,
			      <0x0 0x10140000 0x0 0xe00>;
			reg-names = "pll-wrap", "top-crg", "cpu-ss-clk-sysreg",
				    "cpu-ss-cpu-pll", "ddr0-sysreg",
				    "ddr1-sysreg", "slc-dual-sysreg",
				    "top-crg-t", "cpu-ss-ccu";
			#clock-cells = <1>;
			clocks = <&osc_32k>, <&osc_24m>, <&rc_24m>;
			clock-names = "osc-32k", "osc-24m", "rc-24m";
		};

		clk_peri: clock-controller@300200 {
			compatible = "zhihe,a210-peri-clk";
			reg = <0x0 0x00300200 0x0 0x4>,
			      <0x0 0x02010200 0x0 0x8>,
			      <0x0 0x08400200 0x0 0x8>,
			      <0x0 0x00540200 0x0 0x4>,
			      <0x0 0x27420200 0x0 0x200>;
			reg-names = "peri0-sysreg", "peri1-sysreg",
				    "peri2-sysreg", "peri3-sysreg", "tee-crg";
			#clock-cells = <1>;
		};

		peri3_padctrl: pinctrl@542000 {
			compatible = "zhihe,a210-peri3-pinctrl";
			reg = <0x0 0x00542000 0x0 0x1000>;
			clocks = <&clk_peri PERI3_PAD_CTRL_PCLK_EN>;
			clock-names = "pclk";

			status = "disabled";
		};

		peri3_gpio: gpio@550000 {
			compatible = "zhihe,a210-gpio", "snps,dw-apb-gpio";
			reg = <0x00 0x00550000 0x0 0x10000>;
			#address-cells = <1>;
			clocks = <&clk_peri PERI3_GPIO4_PCLK_EN>,
				 <&clk_peri PERI3_GPIO4_DBCLK_EN>;
			clock-names = "bus", "db";
			#size-cells = <0>;

			gpio4: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <0>;
				#gpio-cells = <2>;
				gpio-controller;
				gpio-ranges = <&peri3_padctrl 0 0 6>;
				#interrupt-cells = <2>;
				interrupt-controller;
				interrupt-parent = <&intc>;
				interrupts = <52 IRQ_TYPE_LEVEL_HIGH>;
				ngpios = <6>;
			};
		};

		rst_peri1: reset-controller@2010400 {
			compatible = "zhihe,a210-peri1-reset";
			reg = <0x0 0x02010400 0x0 0x200>;
			#reset-cells = <1>;
		};

		peri1_gpio0: gpio@2012000 {
			compatible = "zhihe,a210-gpio", "snps,dw-apb-gpio";
			reg = <0x00 0x02012000 0x0 0x1000>;
			#address-cells = <1>;
			clocks = <&clk_peri PERI1_GPIO0_PCLK_EN>,
				 <&clk_peri PERI1_GPIO0_DBCLK_EN>;
			clock-names = "bus", "db";
			#size-cells = <0>;

			gpio0: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <0>;
				#gpio-cells = <2>;
				gpio-controller;
				gpio-ranges = <&peri1_padctrl 0 0 32>;
				#interrupt-cells = <2>;
				interrupt-controller;
				interrupt-parent = <&intc>;
				interrupts = <289 IRQ_TYPE_LEVEL_HIGH>;
				ngpios = <32>;
			};
		};

		peri1_gpio1: gpio@2013000 {
			compatible = "zhihe,a210-gpio", "snps,dw-apb-gpio";
			reg = <0x00 0x02013000 0x0 0x1000>;
			#address-cells = <1>;
			clocks = <&clk_peri PERI1_GPIO1_PCLK_EN>,
				 <&clk_peri PERI1_GPIO1_DBCLK_EN>;
			clock-names = "bus", "db";
			#size-cells = <0>;

			gpio1: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <0>;
				#gpio-cells = <2>;
				gpio-controller;
				gpio-ranges = <&peri1_padctrl 0 32 18>;
				#interrupt-cells = <2>;
				interrupt-controller;
				interrupt-parent = <&intc>;
				interrupts = <290 IRQ_TYPE_LEVEL_HIGH>;
				ngpios = <18>;
			};
		};

		uart0: serial@2014000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x02014000 0x0 0x400>;
			clocks = <&clk_peri PERI1_UART0_SCLK_EN>,
				 <&clk_peri PERI1_UART0_PCLK_EN>;
			clock-names = "baudclk", "apb_pclk";
			interrupt-parent = <&intc>;
			interrupts = <321 IRQ_TYPE_LEVEL_HIGH>;
			reg-io-width = <4>;
			reg-shift = <2>;
			resets = <&rst_peri1 PERI1_UART0_PRST>;

			status = "disabled";
		};

		uart1: serial@2015000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x02015000 0x0 0x1000>;
			clocks = <&clk_peri PERI1_UART1_SCLK_EN>,
				 <&clk_peri PERI1_UART1_PCLK_EN>;
			clock-names = "baudclk", "apb_pclk";
			interrupt-parent = <&intc>;
			interrupts = <322 IRQ_TYPE_LEVEL_HIGH>;
			reg-io-width = <4>;
			reg-shift = <2>;
			resets = <&rst_peri1 PERI1_UART1_PRST>;

			status = "disabled";
		};

		uart2: serial@2016000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x02016000 0x0 0x1000>;
			clocks = <&clk_peri PERI1_UART2_SCLK_EN>,
				 <&clk_peri PERI1_UART2_PCLK_EN>;
			clock-names = "baudclk", "apb_pclk";
			interrupt-parent = <&intc>;
			interrupts = <323 IRQ_TYPE_LEVEL_HIGH>;
			reg-io-width = <4>;
			reg-shift = <2>;
			resets = <&rst_peri1 PERI1_UART2_PRST>;

			status = "disabled";
		};

		uart3: serial@2017000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x02017000 0x0 0x1000>;
			clocks = <&clk_peri PERI1_UART3_SCLK_EN>,
				 <&clk_peri PERI1_UART3_PCLK_EN>;
			clock-names = "baudclk", "apb_pclk";
			interrupt-parent = <&intc>;
			interrupts = <324 IRQ_TYPE_LEVEL_HIGH>;
			reg-io-width = <4>;
			reg-shift = <2>;
			resets = <&rst_peri1 PERI1_UART3_PRST>;

			status = "disabled";
		};

		i2c0: i2c@2020000 {
			compatible = "zhihe,a210-i2c", "snps,designware-i2c";
			reg = <0x00 0x02020000 0x0 0x1000>;
			#address-cells = <1>;
