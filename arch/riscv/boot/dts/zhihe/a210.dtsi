			#mbox-cells = <1>;

			status = "disabled";
		};

		emmc: mmc@500000 {
			compatible = "zhihe,a210-dwcmshc";
			reg = <0x0 0x00500000 0x0 0x10000>;
			clocks = <&clk_peri PERI3_EMMC_SDIO_REF_CLK_CG_EN>,
