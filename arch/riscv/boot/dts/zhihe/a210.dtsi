#include <dt-bindings/ata/ahci.h>
#include <dt-bindings/clock/zhihe,a210-clk.h>
#include <dt-bindings/clock/zhihe,a210-aon-clk.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/reset/zhihe,a210-resets.h>

/ {
	compatible = "zhihe,a210";
	#address-cells = <2>;
	#size-cells = <2>;

	aon_rc: clock-aon-rc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
	};

	osc_24m: clock-osc-24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "osc-24m";
	};

	osc_32k: clock-osc-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "osc-32k";
	};

	aon_110m: clock-osc-110m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <110000000>;
		clock-output-names = "aon-110m";
	};

	rc_24m: clock-rc-24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "rc-24m";
	};

	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <24000000>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&c908_0>;
				};

				core1 {
					cpu = <&c908_1>;
				};

				core2 {
					cpu = <&c908_2>;
				};

				core3 {
					cpu = <&c908_3>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&c920_4>;
				};

				core1 {
					cpu = <&c920_5>;
				};

				core2 {
					cpu = <&c920_6>;
				};

				core3 {
					cpu = <&c920_7>;
				};
			};
		};

		c0_l2_cache: l2-cache0 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <512>;
			cache-size = <524288>;
			cache-unified;
		};

		c1_l2_cache: l2-cache1 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <1024>;
			cache-size = <1048576>;
			cache-unified;
		};

		c908_0: cpu@0 {
			device_type = "cpu";
			compatible = "thead,c908", "riscv";
			reg = <0>;
			#cooling-cells = <2>;
			d-cache-block-size = <64>;
			d-cache-sets = <256>;
			d-cache-size = <32768>;
			i-cache-block-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <32768>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c0_l2_cache>;
			power-domains = <&scmi_perf 0>;
			power-domain-names = "perf";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c908_1: cpu@1 {
			device_type = "cpu";
			compatible = "thead,c908", "riscv";
			reg = <1>;
			#cooling-cells = <2>;
			d-cache-block-size = <64>;
			d-cache-sets = <256>;
			d-cache-size = <32768>;
			i-cache-block-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <32768>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c0_l2_cache>;
			power-domains = <&scmi_perf 0>;
			power-domain-names = "perf";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu1_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c908_2: cpu@2 {
			device_type = "cpu";
			compatible = "thead,c908", "riscv";
			reg = <2>;
			#cooling-cells = <2>;
			d-cache-block-size = <64>;
			d-cache-sets = <256>;
			d-cache-size = <32768>;
			i-cache-block-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <32768>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c0_l2_cache>;
			power-domains = <&scmi_perf 0>;
			power-domain-names = "perf";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu2_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c908_3: cpu@3 {
			device_type = "cpu";
			compatible = "thead,c908", "riscv";
			reg = <3>;
			#cooling-cells = <2>;
			d-cache-block-size = <64>;
			d-cache-sets = <256>;
			d-cache-size = <32768>;
			i-cache-block-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <32768>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c0_l2_cache>;
			power-domains = <&scmi_perf 0>;
			power-domain-names = "perf";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu3_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c920_4: cpu@4 {
			device_type = "cpu";
			compatible = "thead,c920", "riscv";
			reg = <4>;
			#cooling-cells = <2>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <65536>;
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <65536>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c1_l2_cache>;
			power-domains = <&scmi_perf 1>;
			power-domain-names = "perf";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu4_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c920_5: cpu@5 {
			device_type = "cpu";
			compatible = "thead,c920", "riscv";
			reg = <5>;
			#cooling-cells = <2>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <65536>;
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <65536>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c1_l2_cache>;
			power-domains = <&scmi_perf 1>;
			power-domain-names = "perf";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu5_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c920_6: cpu@6 {
			device_type = "cpu";
			compatible = "thead,c920", "riscv";
			reg = <6>;
			#cooling-cells = <2>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <65536>;
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <65536>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c1_l2_cache>;
			power-domains = <&scmi_perf 1>;
			power-domain-names = "perf";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu6_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		c920_7: cpu@7 {
			device_type = "cpu";
			compatible = "thead,c920", "riscv";
			reg = <7>;
			#cooling-cells = <2>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <65536>;
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <65536>;
			mmu-type = "riscv,sv39";
			next-level-cache = <&c1_l2_cache>;
			power-domains = <&scmi_perf 1>;
			power-domain-names = "perf";
			riscv,cbom-block-size = <64>;
			riscv,cbop-block-size = <64>;
			riscv,cboz-block-size = <64>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
					       "b", "v", "sscofpmf", "sstc",
					       "svpbmt", "zba", "zbb", "zbc",
					       "zbs", "zicbom", "zicbop",
					       "zicboz", "zicntr", "zicsr",
					       "zifencei", "zihpm";

			cpu7_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};
	};

	firmware {
		scmi: scmi {
			compatible = "arm,scmi";
			#address-cells = <1>;
			mbox-names = "tx";
			mboxes = <&mbox_e902 0>;
			shmem = <&scmi_shmem>;
			#size-cells = <0>;

			status = "disabled";

			scmi_perf: protocol@13 {
				reg = <0x13>;
				#power-domain-cells = <1>;
			};

			scmi_voltage: protocol@17 {
				reg = <0x17>;
			};
		};
	};

	power: power-controller {
		compatible = "zhihe,a210-power-domain";
		ranges;
		#address-cells = <2>;
		#power-domain-cells = <0>;
		#size-cells = <2>;

		power_dmac: power-domain-dmac {
			compatible = "zhihe,a210-pd-dmac";
			clocks = <&clk_peri AXI_PERI3_MST_ACLK_EN>,
				 <&clk_peri AXI_PERI3_MST_PCLK_EN>;
			#power-domain-cells = <0>;
			power-domains = <&power_top>;
		};

		power_emmc: power-domain-emmc {
			compatible = "zhihe,a210-pd-emmc";
			clocks = <&clk_peri AXI_PERI3_MST_ACLK_EN>,
				 <&clk_peri AXI_PERI3_MST_PCLK_EN>,
				 <&clk_peri PERI3_EMMC_ACLK_EN>,
				 <&clk_peri PERI3_EMMC_X2X_ACLK_S_EN>,
				 <&clk_peri PERI3_EMMC_X2X_ACLK_M_EN>,
				 <&clk_peri PERI3_EMMC_OSC_CLK_EN>;
			#power-domain-cells = <0>;
			power-domains = <&power_top>;
		};

		power_pwm: power-domain-pwm {
			compatible = "zhihe,a210-pd-pwm";
			#power-domain-cells = <0>;
			power-domains = <&power_top>;
			resets = <&rst_peri1 PERI1_PWM0_CRST>,
				 <&rst_peri1 PERI1_PWM0_PRST>,
				 <&rst_peri2 PERI2_PWM1_CRST>,
				 <&rst_peri2 PERI2_PWM1_PRST>,
				 <&rst_peri2 PERI2_PWM2_CRST>,
				 <&rst_peri2 PERI2_PWM2_PRST>;
		};

		power_sdio: power-domain-sdio {
			compatible = "zhihe,a210-pd-sdio";
			clocks = <&clk_peri AXI_PERI3_MST_ACLK_EN>,
				 <&clk_peri AXI_PERI3_MST_PCLK_EN>,
				 <&clk_peri PERI3_SDIO_ACLK_EN>,
				 <&clk_peri PERI3_SDIO_X2X_ACLK_S_EN>,
				 <&clk_peri PERI3_SDIO_X2X_ACLK_M_EN>,
				 <&clk_peri PERI3_SDIO_OSC_CLK_EN>;
			#power-domain-cells = <0>;
			power-domains = <&power_top>;
		};

		power_top: power-domain-top {
			compatible = "zhihe,a210-pd-top";
			ranges;
			#address-cells = <2>;
			#power-domain-cells = <0>;
			#size-cells = <2>;

			ddr_ccu: clock-controller@5910000 {
				compatible = "zhihe,a210-ccu";
				reg = <0x00 0x05910000 0x0 0x2c>,
				      <0x00 0x05920000 0x0 0x2c>;
				zhihe,ccu-dly-time = <0x5e 0x5e>;
				zhihe,ccu-dly-time-step = <0x3 0x3>;
			};

			pcie_ccu: clock-controller@a007400 {
				compatible = "zhihe,a210-ccu";
				reg = <0x00 0x0a007400 0x0 0x2c>,
				      <0x00 0x0a008000 0x0 0x2c>,
				      <0x00 0x0a008400 0x0 0x2c>;
				zhihe,ccu-dly-time = <0x5e 0x5e 0x5e>;
				zhihe,ccu-dly-time-step = <0x3 0x3 0x3>;
			};

			cpu_gating_ccu: clock-controller@10140000 {
				compatible = "zhihe,a210-ccu";
				reg = <0x00 0x10140000 0x0 0x2c>,
				      <0x00 0x10140200 0x0 0x2c>,
				      <0x00 0x10140400 0x0 0x2c>,
				      <0x00 0x10140600 0x0 0x2c>,
				      <0x00 0x10140a00 0x0 0x2c>,
				      <0x00 0x10140c00 0x0 0x2c>,
				      <0x00 0x10204000 0x0 0x2c>,
				      <0x00 0x10204200 0x0 0x2c>,
				      <0x00 0x10204400 0x0 0x2c>,
				      <0x00 0x10204600 0x0 0x2c>,
				      <0x00 0x10204800 0x0 0x2c>,
				      <0x00 0x10204a00 0x0 0x2c>,
				      <0x00 0x10205400 0x0 0x2c>;
				zhihe,ccu-dly-time = <0x34 0x34 0x34
						     0x34 0x34 0x34
						     0x34 0x34 0x34
						     0x34 0x34 0x34
						     0x34>;
				zhihe,ccu-dly-time-step = <0x2 0x2 0x2
							  0x2 0x2 0x2
							  0x2 0x2 0x2
							  0x2 0x2 0x2
							  0x2>;
			};

			cpu_scaling_ccu: clock-controller@10140800 {
				compatible = "zhihe,a210-ccu";
				reg = <0x00 0x10140800 0x0 0x2c>;
				zhihe,ccu-dly-time = <0x34>;
				zhihe,ccu-dly-time-step = <0x2>;
				zhihe,ccu-mode = <1>;
				zhihe,ccu-ratio = <63>;
			};

			tee_ccu: clock-controller@27430000 {
				compatible = "zhihe,a210-ccu";
				reg = <0x00 0x27430000 0x0 0x2c>;
				zhihe,ccu-dly-time = <0x5e>;
				zhihe,ccu-dly-time-step = <0x3>;
			};
		};

		power_usb: power-domain-usb {
			compatible = "zhihe,a210-pd-usb";
			ranges;
			#address-cells = <2>;
			clocks = <&clk_usb USB_SS_AXI_MST_PCLK_EN>,
				 <&clk_usb USB_SS_AXI_MST_ACLK_EN>,
				 <&clk_usb USB_SS_DFMU_IOMMU_PTW_ACLK_EN>,
				 <&clk_usb USB_SS_DFMU_ACLK_EN>,
				 <&clk_usb USB_SS_DFMU_PCLK_EN>,
				 <&clk_usb USB31_SLV_AFENCE_ACLK_EN>,
				 <&clk_usb USB20_X2H_HCLK>,
				 <&clk_usb USB20_X2H_ACLK>,
				 <&clk_usb USB20_SLV_AFENCE_ACLK>,
				 <&clk_usb USB20_H2P_HCLK>,
				 <&clk_usb USB20_AHB_SLV_HCLK>,
				 <&clk_usb USB20_SYSREG_PCLK>,
				 <&clk_usb USB20_A2X0_HCLK>,
				 <&clk_usb USB20_A2X0_ACLK>,
				 <&clk_usb USB20_A2X1_HCLK>,
				 <&clk_usb USB20_A2X1_ACLK>,
				 <&clk_usb USB20_BUS_CLK>;
			#power-domain-cells = <0>;
			power-domains = <&power_top>;
			resets = <&rst_usb USB_DFMU_PRST>,
				 <&rst_usb USB_DFMU_ARST>,
				 <&rst_usb USB_AXI4_MST_ARST>,
				 <&rst_usb USB_AXI4_MST_PRST>,
				 <&rst_usb USB_USB31_SLV_AFENCE_ARST>,
				 <&rst_usb USB_USB31_APBS_PRST>,
				 <&rst_usb USB_USB20_BLK_X2H_HRST>,
				 <&rst_usb USB_USB20_BLK_X2H_ARST>,
				 <&rst_usb USB_USB20_SLV_AFENCE_ARST>,
				 <&rst_usb USB_USB20_BLK_H2P_HRST>,
				 <&rst_usb USB_USB20_BLK_AHB_SLV_HRST>,
				 <&rst_usb USB_USB20_BLK_AXI_MST_ARST>,
				 <&rst_usb USB_USB20_BLK_USB2_SYSREG_PRST>,
				 <&rst_usb USB_USB20_BLK_USB2_WRAP0_PRST>,
				 <&rst_usb USB_USB20_BLK_USB2_WRAP1_PRST>,
				 <&rst_usb USB_USB20_BLK_A2X0_HRST>,
				 <&rst_usb USB_USB20_BLK_A2X0_ARST>,
				 <&rst_usb USB_USB20_BLK_A2X1_HRST>,
				 <&rst_usb USB_USB20_BLK_A2X1_ARST>;
			#size-cells = <2>;

			usb_ccu: clock-controller@0 {
				compatible = "zhihe,a210-ccu";
				reg = <0x00 0x08004400 0x0 0x2c>,
				      <0x00 0x08006000 0x0 0x2c>,
				      <0x00 0x08006400 0x0 0x2c>;
				zhihe,ccu-dly-time = <0x5e 0x5e 0x5e>;
				zhihe,ccu-dly-time-step = <0x3 0x3 0x3>;
			};
		};

		power_vo: power-domain-vo@67f1000 {
			compatible = "zhihe,a210-pd-vo";
			reg = <0 0x067f1000 0 0x200>,
			      <0 0x067f0000 0 0x200>,
			      <0 0x06720000 0 0x1000>,
			      <0 0x26712000 0 0x1000>;
			reg-names = "bpc", "pcu", "syscon", "iopmp";
			clocks = <&clk_vo VO_X2H0_CLK_EN>,
				 <&clk_vo VO_X2H1_CLK_EN>,
				 <&clk_vo VO_ARB_PCLK_EN>,
				 <&clk_vo VO_ARB_ACLK_EN>,
				 <&clk_vo VO_DFMU_PCLK_EN>,
				 <&clk_vo VO_DFMU_ACLK_EN>,
				 <&clk_vo VO_PTW_ACLK_EN>;
			#power-domain-cells = <0>;
			power-domains = <&power_top>;
			resets = <&rst_vo VO_X2H0_RST>, <&rst_vo VO_X2H1_RST>,
				 <&rst_vo VO_ARB_PRST>, <&rst_vo VO_ARB_ARST>,
				 <&rst_vo VO_DFMU_PRST>, <&rst_vo VO_DFMU_ARST>;
		};

		power_gpu: power-domain-gpu@6e00600 {
			compatible = "zhihe,a210-pd-gpu";
			reg = <0 0x06e00600 0 0x200>,
			      <0 0x06e00400 0 0x200>,
			      <0 0x06e00000 0 0x200>,
			      <0 0x26d12000 0 0x1000>;
			reg-names = "pca", "bpc", "pcu", "iopmp";
			clocks = <&clk TOP_GPU_CORE_CLK_DIV>;
			#power-domain-cells = <0>;
			power-domains = <&power_top>;
		};

		power_pcie0: power-domain-pcie0@a006200 {
			compatible = "zhihe,a210-pd-pcie0";
			reg = <0 0x0a006200 0 0x200>,
			      <0 0x0a006000 0 0x200>;
			reg-names = "bpc", "pcu";
			#power-domain-cells = <0>;
			power-domains = <&power_top>;
		};

		power_pcie1: power-domain-pcie1@a006600 {
			compatible = "zhihe,a210-pd-pcie1";
			reg = <0 0x0a006600 0 0x200>,
			      <0 0x0a006400 0 0x200>;
			reg-names = "bpc", "pcu";
			#power-domain-cells = <0>;
			power-domains = <&power_top>;
		};

		power_sata: power-domain-sata@a006a00 {
			compatible = "zhihe,a210-pd-sata";
			reg = <0 0x0a006a00 0 0x200>,
			      <0 0x0a006800 0 0x200>;
			reg-names = "bpc", "pcu";
			clocks = <&clk_pcie SATA_GEN3X2_ACLK_EN>,
				 <&clk_pcie SATA_PMALIVE_CLK_EN>,
				 <&clk_pcie SATA_MST_AFENCE_ACLK_EN>,
				 <&clk_pcie SATA_SLV_AFENCE_ACLK_EN>,
				 <&clk_pcie X2X_SATA_SLV_ACLK_EN>,
				 <&clk_pcie X2X_SATA_MST_ACLK_EN>,
				 <&clk_pcie SATA_RXOOB0_CLK_EN>,
				 <&clk_pcie SATA_RXOOB1_CLK_EN>;
			phys = <&e16phy>;
			#power-domain-cells = <0>;
			power-domains = <&power_top>;
			resets = <&rst_pcie PCIE_X2X_SATA_MST_ARST>,
				 <&rst_pcie PCIE_X2X_SATA_SLV_ARST>,
				 <&rst_pcie PCIE_SATA_SLV_AFENCE_ARST>,
				 <&rst_pcie PCIE_SATA_MST_AFENCE_ARST>,
				 <&rst_pcie PCIE_SATA_RST_ASIC0>,
				 <&rst_pcie PCIE_SATA_RST_ASIC1>,
				 <&rst_pcie PCIE_SATA_RST_RXOOB0>,
				 <&rst_pcie PCIE_SATA_RST_RXOOB1>;

			status = "disabled";
		};
	};

	soc {
		compatible = "simple-bus";
		ranges;
		#address-cells = <2>;
		dma-noncoherent;
		#size-cells = <2>;

		clk: clock-controller@260000 {
			compatible = "zhihe,a210-clk";
			reg = <0x0 0x00260000 0x0 0x1000>,
			      <0x0 0x00250000 0x0 0x1000>,
			      <0x0 0x10141600 0x0 0x100>,
			      <0x0 0x10141400 0x0 0x100>,
			      <0x0 0x04810000 0x0 0x1000>,
			      <0x0 0x05810000 0x0 0x1000>,
			      <0x0 0x04900000 0x0 0x1000>,
			      <0x0 0x20250000 0x0 0x1000>,
			      <0x0 0x10140000 0x0 0xe00>;
			reg-names = "pll-wrap", "top-crg", "cpu-ss-clk-sysreg",
				    "cpu-ss-cpu-pll", "ddr0-sysreg",
				    "ddr1-sysreg", "slc-dual-sysreg",
				    "top-crg-t", "cpu-ss-ccu";
			#clock-cells = <1>;
			clocks = <&osc_32k>, <&osc_24m>, <&rc_24m>;
			clock-names = "osc-32k", "osc-24m", "rc-24m";
		};

		clk_peri: clock-controller@300200 {
			compatible = "zhihe,a210-peri-clk";
			reg = <0x0 0x00300200 0x0 0x4>,
			      <0x0 0x02010200 0x0 0x8>,
			      <0x0 0x08400200 0x0 0x8>,
			      <0x0 0x00540200 0x0 0x4>,
			      <0x0 0x27420200 0x0 0x200>;
			reg-names = "peri0-sysreg", "peri1-sysreg",
				    "peri2-sysreg", "peri3-sysreg", "tee-crg";
			#clock-cells = <1>;
		};

		rst_peri0: reset-controller@300400 {
			compatible = "zhihe,a210-peri0-reset";
			reg = <0x00 0x00300400 0x0 0x200>;
			#reset-cells = <1>;
		};

		timer0: timer@303000 {
			compatible = "snps,dw-apb-timer";
			reg = <0x00 0x00303000 0x0 0x14>;
			clocks = <&clk_peri PERI0_TIMER0_CCLK_EN>,
				 <&clk_peri PERI0_TIMER0_PCLK_EN>;
			clock-names = "timer", "pclk";
			interrupt-parent = <&intc>;
			interrupts = <313 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&rst_peri0 PERI0_TIMER0_RST>;

			status = "disabled";
		};

		timer1: timer@303014 {
			compatible = "snps,dw-apb-timer";
			reg = <0x00 0x00303014 0x0 0x14>;
			clocks = <&clk_peri PERI0_TIMER0_CCLK_EN>,
				 <&clk_peri PERI0_TIMER0_PCLK_EN>;
			clock-names = "timer", "pclk";
			interrupt-parent = <&intc>;
			interrupts = <314 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&rst_peri0 PERI0_TIMER0_RST>;

			status = "disabled";
		};

		timer2: timer@303028 {
			compatible = "snps,dw-apb-timer";
			reg = <0x00 0x00303028 0x0 0x14>;
			clocks = <&clk_peri PERI0_TIMER0_CCLK_EN>,
				 <&clk_peri PERI0_TIMER0_PCLK_EN>;
			clock-names = "timer", "pclk";
			interrupt-parent = <&intc>;
			interrupts = <315 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&rst_peri0 PERI0_TIMER0_RST>;

			status = "disabled";
		};

		timer3: timer@30303c {
			compatible = "snps,dw-apb-timer";
