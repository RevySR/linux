			interrupt-parent = <&intc>;
			interrupts = <299 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&rst_peri2 PERI2_I2C6_RST>;
			#size-cells = <0>;

			status = "disabled";
		};

		i2c7: i2c@8419000 {
			compatible = "zhihe,a210-i2c", "snps,designware-i2c";
			reg = <0x00 0x08419000 0x0 0x1000>;
			#address-cells = <1>;
			clocks = <&clk_peri PERI2_I2C7_IC_CLK_EN>,
				 <&clk_peri PERI2_I2C7_PCLK_EN>;
			clock-names = "ref", "pclk";
			interrupt-parent = <&intc>;
			interrupts = <300 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&rst_peri2 PERI2_I2C7_RST>;
			#size-cells = <0>;

			status = "disabled";
		};

		pwm1: pwm@841a000 {
			compatible = "zhihe,a210-pwm", "thead,th1520-pwm";
			reg = <0 0x0841a000 0 0x1000>;
			clocks = <&clk_peri PERI2_PWM1_CCLK_EN>;
			power-domains = <&power_pwm>;
			#pwm-cells = <3>;

			status = "disabled";
		};

		pwm2: pwm@841b000 {
			compatible = "zhihe,a210-pwm", "thead,th1520-pwm";
			reg = <0 0x0841b000 0 0x1000>;
			clocks = <&clk_peri PERI2_PWM2_CCLK_EN>;
			power-domains = <&power_pwm>;
			#pwm-cells = <3>;

			status = "disabled";
		};

		qspi1: spi@8428000 {
			compatible = "zhihe,a210-qspi", "snps,dwc-ssi-1.01a";
			reg = <0x00 0x08428000 0x0 0x4000>;
			#address-cells = <1>;
			clocks = <&clk_peri PERI2_QSPI1_SSI_CLK_EN>,
				 <&clk_peri PERI2_QSPI1_PCLK_EN>;
			clock-names = "ssi_clk", "pclk";
			interrupt-parent = <&intc>;
			interrupts = <309 IRQ_TYPE_LEVEL_HIGH>;
			num-cs = <2>;
			power-domains = <&power_top>;
			resets = <&rst_peri2 PERI2_QSPI1_SSI_RST>,
				 <&rst_peri2 PERI2_QSPI1_PRST>;
			#size-cells = <0>;

			status = "disabled";
		};

		clk_pcie: clock-controller@a000000 {
			compatible = "zhihe,a210-pcie-clk";
			reg = <0 0x0a000000 0 0x28>;
			reg-names = "pcie-clk-en";
			#clock-cells = <1>;
		};

		rst_pcie: reset-controller@a000100 {
			compatible = "zhihe,a210-pcie-reset";
			reg = <0x00 0x0a000100 0x0 0x100>;
			#reset-cells = <1>;
		};

		e16phy: phy@a180000 {
			compatible = "zhihe,a210-e16-phy";
			reg = <0 0x0a180000 0 0x1000>,
			      <0 0x0a100000 0 0x40000>,
			      <0 0x0a140000 0 0x40000>;
			reg-names = "sysreg", "phy0", "phy1";
			#phy-cells = <0>;
			resets = <&rst_pcie PCIE_E16PHY_APBS_PRST>,
				 <&rst_pcie PCIE_E16PHY_PHY_RST>;
			reset-names = "apb", "phy";

			status = "disabled";
		};

		sata: sata@a200000 {
			compatible = "snps,dwc-ahci";
			reg = <0 0x0a200000 0 0x100000>;
			#address-cells = <1>;
			clocks = <&clk_pcie SATA_GEN3X2_ACLK_EN>,
				 <&clk_pcie SATA_PMALIVE_CLK_EN>;
			clock-names = "aclk", "pmalive";
			interrupt-parent = <&intc>;
			interrupts = <170 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&power_sata>;
			resets = <&rst_pcie PCIE_SATA_ARESET>,
				 <&rst_pcie PCIE_SATA_RST_PMALIVE>;
			reset-names = "arst", "pmalive";
			#size-cells = <0>;

			status = "disabled";

			sata0: sata-port@0 {
				reg = <0>;
				phys = <&e16phy>;
				phy-names = "sata-phy";
			};

			sata1: sata-port@1 {
				reg = <1>;
				phys = <&e16phy>;
				phy-names = "sata-phy";
			};
		};

		pcie0: pcie@b000000 {
			device_type = "pci";
			compatible = "zhihe,a210-pcie";
			reg = <0 0x0b000000 0 0x800000>,
			      <0x18 0 0 0x200000>, <0 0x0a004000 0 0x1000>;
			reg-names = "dbi", "config", "app";
			ranges = <0x01000000 0 0 0x18 0x200000 0 0x10000>,
				 <0x02000000 0 0x40100000 0 0x40100000 0 0x800000>,
				 <0x43000000 0x18 0x300000 0x18 0x300000
				 0 0x800000>;
			#address-cells = <3>;
			bus-range = <0 255>;
			clocks = <&clk_pcie PCIE_DM_GEN3X4_AUX_CLK_EN>,
				 <&clk_pcie PCIE_DM_GEN3X4_SLV_ACLK_EN>,
				 <&clk_pcie PCIE_DM_GEN3X4_MST_ACLK_EN>,
				 <&clk_pcie PCIE_DM_GEN3X4_PCLK_EN>;
			clock-names = "aux", "slv", "mstr", "dbi";
			#interrupt-cells = <1>;
			interrupt-map = <0 0 0 1 &intc 140 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 2 &intc 141 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 3 &intc 142 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 4 &intc 143 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-parent = <&intc>;
			interrupts = <139 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi";
			max-link-speed = <3>;
			num-lanes = <4>;
			phys = <&e16phy>;
			phy-names = "pcie";
			power-domains = <&power_pcie0>;
			resets = <&rst_pcie PCIE_DM_GEN3X4_APBS_PRST>,
				 <&rst_pcie PCIE_DM_GEN3X4_POWER_UP_RST>;
			reset-names = "dbi", "pwr";
			#size-cells = <2>;

			status = "disabled";
		};

		pcie1: pcie@b800000 {
			device_type = "pci";
			compatible = "zhihe,a210-pcie";
			reg = <0 0x0b800000 0 0x800000>,
			      <0x1e 0 0 0x20000>, <0 0x0a005000 0 0x1000>;
			reg-names = "dbi", "config", "app";
			ranges = <0x01000000 0 0 0x1e 0x200000 0 0x10000>,
				 <0x02000000 0 0x50100000 0 0x50100000 0 0x800000>,
				 <0x43000000 0x1e 0x300000 0x1e 0x300000
				 0 0x800000>;
			#address-cells = <3>;
			bus-range = <0 255>;
			clocks = <&clk_pcie PCIE_RP_GEN3X1_AUX_CLK_EN>,
				 <&clk_pcie PCIE_RP_GEN3X1_SLV_ACLK_EN>,
				 <&clk_pcie PCIE_RP_GEN3X1_MST_ACLK_EN>,
				 <&clk_pcie PCIE_RP_GEN3X1_PCLK_EN>;
			clock-names = "aux", "slv", "mstr", "dbi";
			#interrupt-cells = <1>;
			interrupt-map = <0 0 0 1 &intc 159 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 2 &intc 160 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 3 &intc 161 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 4 &intc 162 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-parent = <&intc>;
			interrupts = <158 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi";
			max-link-speed = <3>;
			num-lanes = <1>;
			phys = <&e16phy>;
			phy-names = "pcie";
			power-domains = <&power_pcie1>;
			resets = <&rst_pcie PCIE_RP_GEN3X1_APBS_PRST>,
				 <&rst_pcie PCIE_RP_GEN3X1_POWER_UP_RST>;
			reset-names = "dbi", "pwr";
			#size-cells = <2>;

			status = "disabled";
		};

		intc: interrupt-controller@18000000 {
			compatible = "zhihe,a210-plic", "thead,c900-plic";
			reg = <0x0 0x18000000 0x0 0x04000000>;
			#address-cells = <0>;
			#interrupt-cells = <2>;
			interrupt-controller;
			interrupts-extended = <&cpu0_intc 0xffffffff>,
					      <&cpu0_intc 9>,
					      <&cpu1_intc 0xffffffff>,
					      <&cpu1_intc 9>,
					      <&cpu2_intc 0xffffffff>,
					      <&cpu2_intc 9>,
					      <&cpu3_intc 0xffffffff>,
					      <&cpu3_intc 9>,
					      <&cpu4_intc 0xffffffff>,
					      <&cpu4_intc 9>,
					      <&cpu5_intc 0xffffffff>,
					      <&cpu5_intc 9>,
					      <&cpu6_intc 0xffffffff>,
					      <&cpu6_intc 9>,
					      <&cpu7_intc 0xffffffff>,
					      <&cpu7_intc 9>;
			riscv,ndev = <351>;
		};

		clint0: clint@1c000000 {
			compatible = "zhihe,a210-clint", "thead,c900-clint";
			reg = <0x0 0x1c000000 0x0 0x0000d800>;
			interrupts-extended = <&cpu0_intc 3>,
					      <&cpu0_intc 7>,
					      <&cpu1_intc 3>,
					      <&cpu1_intc 7>,
					      <&cpu2_intc 3>,
					      <&cpu2_intc 7>,
					      <&cpu3_intc 3>,
					      <&cpu3_intc 7>,
					      <&cpu4_intc 3>,
					      <&cpu4_intc 7>,
					      <&cpu5_intc 3>,
					      <&cpu5_intc 7>,
					      <&cpu6_intc 3>,
					      <&cpu6_intc 7>,
					      <&cpu7_intc 3>,
					      <&cpu7_intc 7>;
		};

		rst_tee: reset-controller@27420400 {
			compatible = "zhihe,a210-tee-reset";
			reg = <0x00 0x27420400 0x0 0x200>;
			#reset-cells = <1>;
		};

		dmac1: dma-controller@27540000 {
			compatible = "zhihe,a210-axi-dma", "snps,axi-dma-1.01a";
			reg = <0x00 0x27540000 0x0 0x4000>;
			clocks = <&clk_peri TEE_DMAC_CLKEN>,
				 <&clk_peri TEE_DMAC_CLKEN>;
			clock-names = "core-clk", "cfgr-clk";
			#dma-cells = <1>;
			dma-channels = <4>;
			interrupt-parent = <&intc>;
			interrupts = <259 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&rst_tee TEE_DMAC_ARST>,
				 <&rst_tee TEE_DMAC_HRST>;
			snps,axi-max-burst-len = <16>;
			snps,block-size = <65536 65536 65536 65536>;
			snps,data-width = <4>;
			snps,dma-masters = <1>;
			snps,priority = <0 0 0 0>;

			status = "disabled";
		};

		aon_gpio0: gpio@30841000 {
			compatible = "snps,dw-apb-gpio";
			reg = <0x00 0x30841000 0x0 0x1000>;
			#address-cells = <1>;
			clocks = <&aon_110m>, <&osc_32k>;
			clock-names = "bus", "db";
			#size-cells = <0>;

			ao_gpio0: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <0>;
				#gpio-cells = <2>;
				gpio-controller;
				gpio-ranges = <&aon_padctrl 0 7 15>,
					      <&aon_padctrl 21 22 11>;
				#interrupt-cells = <2>;
				interrupt-controller;
				interrupt-parent = <&intc>;
				interrupts = <17 IRQ_TYPE_LEVEL_HIGH>;
				ngpios = <32>;
			};
		};

		clk_aon: clock-controller@30844000 {
			compatible = "zhihe,a210-aon-clk";
			reg = <0 0x30844000 0 0x1c>;
			#clock-cells = <1>;
			clocks = <&aon_110m>, <&osc_24m>, <&aon_rc>, <&osc_32k>;
			clock-names = "high", "osc", "rc", "rtc";
		};

		aon_padctrl: pinctrl@30848000 {
			compatible = "zhihe,a210-aon-pinctrl";
			reg = <0x0 0x30848000 0x0 0x2000>;
			clocks = <&clk_aon A210_AON_SYS_CLK>;
			clock-names = "pclk";

			status = "disabled";
		};

		pvt: pvt@3084c000 {
			compatible = "moortec,mr75203";
			reg = <0x00 0x3084c000 0x0 0x80>,
			      <0x00 0x3084c080 0x0 0x180>,
			      <0x00 0x3084c200 0x0 0x200>,
			      <0x00 0x3084c400 0x0 0x200>;
			reg-names = "common", "ts", "pd", "vm";
			clocks = <&aon_110m>;
			#thermal-sensor-cells = <1>;
			moortec,ts-coeff-cal5 = <4094>;
			moortec,ts-coeff-h = <220000>;
		};

		aoi2c1: i2c@30891000 {
			compatible = "snps,designware-i2c";
			reg = <0x00 0x30891000 0x0 0x1000>;
			#address-cells = <1>;
			clocks = <&clk_aon A210_AON_I2C1_IC_CLK>,
				 <&clk_aon A210_AON_I2C1_PCLK>;
			clock-names = "ref", "pclk";
			interrupt-parent = <&intc>;
			interrupts = <20 IRQ_TYPE_LEVEL_HIGH>;
			#size-cells = <0>;

			status = "disabled";
		};

		aon_gpio1: gpio@30897000 {
			compatible = "snps,dw-apb-gpio";
			reg = <0x00 0x30897000 0x0 0x1000>;
			#address-cells = <1>;
			clocks = <&aon_110m>, <&osc_32k>;
			clock-names = "bus", "db";
			#size-cells = <0>;

			ao_gpio1: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <0>;
				#gpio-cells = <2>;
				gpio-controller;
				gpio-ranges = <&aon_padctrl 0 33 10>;
				#interrupt-cells = <2>;
				interrupt-controller;
				interrupt-parent = <&intc>;
				interrupts = <10 IRQ_TYPE_LEVEL_HIGH>;
				ngpios = <10>;
			};
		};

		sram@30907c00 {
			compatible = "mmio-sram";
			reg = <0 0x30907c00 0 0x100>;
			ranges = <0 0 0x30907c00 0x100>;
			#address-cells = <1>;
			#size-cells = <1>;

			scmi_shmem: scp-sram@0 {
				compatible = "arm,scmi-shmem";
				reg = <0 0x100>;
			};
		};
	};

	stmmac_axi_setup: stmmac-axi-config {
		snps,blen = <16 8 4 0 0 0 0>;
		snps,rd_osr_lmt = <7>;
		snps,wr_osr_lmt = <7>;
	};
};
