			compatible = "snps,dw-apb-gpio";
			reg = <0x00 0x30841000 0x0 0x1000>;
			#address-cells = <1>;
			clocks = <&aon_110m>, <&osc_32k>;
			clock-names = "bus", "db";
			#size-cells = <0>;

