		};

		peri3_gpio: gpio@550000 {
			compatible = "zhihe,a210-gpio", "snps,dw-apb-gpio";
			reg = <0x00 0x00550000 0x0 0x10000>;
			#address-cells = <1>;
			clocks = <&clk_peri PERI3_GPIO4_PCLK_EN>,
				 <&clk_peri PERI3_GPIO4_DBCLK_EN>;
			clock-names = "bus", "db";
			#size-cells = <0>;

			gpio4: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <0>;
				#gpio-cells = <2>;
				gpio-controller;
				gpio-ranges = <&peri3_padctrl 0 0 6>;
				#interrupt-cells = <2>;
				interrupt-controller;
				interrupt-parent = <&intc>;
				interrupts = <52 IRQ_TYPE_LEVEL_HIGH>;
				ngpios = <6>;
			};
		};

