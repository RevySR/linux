		peri2_gpio2: gpio@8410000 {
			compatible = "zhihe,a210-gpio", "snps,dw-apb-gpio";
			reg = <0x00 0x08410000 0x0 0x1000>;
			#address-cells = <1>;
			clocks = <&clk_peri PERI2_GPIO2_PCLK_EN>,
				 <&clk_peri PERI2_GPIO2_DBCLK_EN>;
			clock-names = "bus", "db";
			#size-cells = <0>;

			gpio2: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <0>;
				#gpio-cells = <2>;
				gpio-controller;
				gpio-ranges = <&peri2_padctrl 0 0 32>;
				#interrupt-cells = <2>;
				interrupt-controller;
