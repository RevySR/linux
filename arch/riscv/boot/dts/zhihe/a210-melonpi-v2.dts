/dts-v1/;

#include "a210-melonpi-common.dtsi"
#include <dt-bindings/usb/pd.h>

/ {
	compatible = "zhihe,a210-melonpi-v2", "zhihe,a210-som", "zhihe,a210";
	model = "Melon Pi V2";

	pcie_clock_power: pcie-clock-power {
		compatible = "gpio-gate-clock";
		#clock-cells = <0>;
		clocks = <&pcie_osc>;
		enable-gpios = <&aw9535_1 13 GPIO_ACTIVE_HIGH>;
	};

	pcie_osc: pcie-oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	pcie_ref: pcie-reference-clock {
		compatible = "gpio-gate-clock";
		#clock-cells = <0>;
		clocks = <&pcie_clock_power>;
		enable-gpios = <&aw9535_0 12 GPIO_ACTIVE_HIGH>;
	};

	regulator-fan {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 30 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&fan_enable_pins>;
		pinctrl-names = "default";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "fan-5v";
	};

	reg_m2_sata: regulator-m2-sata {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_0 14 GPIO_ACTIVE_HIGH>;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "m2-sata-3v3";
		startup-delay-us = <10000>;
	};

	reg_minipcie_1v5: regulator-minipcie-1v5 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_0 6 GPIO_ACTIVE_HIGH>;
		regulator-max-microvolt = <1500000>;
		regulator-min-microvolt = <1500000>;
		regulator-name = "minipcie-1v5";
		startup-delay-us = <100000>;
		vin-supply = <&vdd_3v3>;
	};

	reg_minipcie_3v3: regulator-minipcie-3v3 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_0 7 GPIO_ACTIVE_HIGH>;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "minipcie-3v3";
		startup-delay-us = <100000>;
		vin-supply = <&vdd_3v3>;
	};

	reg_pcie_eth: regulator-pcie-ethernet {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_1 6 GPIO_ACTIVE_HIGH>;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "pcie-ethernet-3v3";
		startup-delay-us = <100000>;
		vin-supply = <&vdd_3v3>;
	};

	reg_usb_c: regulator-usb-c {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 27 GPIO_ACTIVE_HIGH>;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "usb-c-vbus";
	};

	reg_wifi_1v8: regulator-wifi-1v8 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_1 12 GPIO_ACTIVE_HIGH>;
		regulator-always-on;
		regulator-max-microvolt = <1800000>;
		regulator-min-microvolt = <1800000>;
		regulator-name = "wifi-bt-1v8";
		startup-delay-us = <1000>;
	};

	reg_wifi_3v3: regulator-wifi-3v3 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_1 11 GPIO_ACTIVE_HIGH>;
		regulator-always-on;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "wifi-bt-3v3";
		startup-delay-us = <1000>;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rtc>;
		clock-names = "ext_clock";
		pinctrl-0 = <&wifi_enable_pins>;
		pinctrl-names = "default";
		post-power-on-delay-ms = <200>;
		reset-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
	};
};

&peri1_padctrl {
	bt_wake_pins: bt-wake-0 {
		gpio-pins {
			bias-disable;
			drive-strength = <7>;
			input-disable;
			pins = "GPIO0_17";
		};
	};

	fan_enable_pins: fan-enable-0 {
		gpio-pins {
			bias-disable;
			drive-strength = <7>;
			input-disable;
			pins = "GPIO0_30";
		};
	};

	pcie0_clkreq_pins: pcie0-clkreq-0 {
		clkreq-pins {
			bias-disable;
			drive-strength = <7>;
			function = "pcie_x4";
			input-enable;
			input-schmitt-enable;
			pins = "GPIO0_29";
			slew-rate = <0>;
		};
	};

	pcie1_clkreq_pins: pcie1-clkreq-0 {
		clkreq-pins {
			bias-disable;
			drive-strength = <7>;
			function = "pcie_x1";
			input-enable;
			input-schmitt-enable;
			pins = "GPIO0_25";
			slew-rate = <0>;
		};
	};

	wifi_enable_pins: wifi-enable-0 {
		gpio-pins {
			bias-disable;
			drive-strength = <7>;
			input-disable;
			pins = "GPIO0_14";
		};
	};
};

&aw9535_0 {
	m2-sata-enable-hog {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>;
		line-name = "m2-sata-enable";
		output-high;
	};

	minipcie-wireless-enable-hog {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_HIGH>;
		line-name = "minipcie-wireless-enable";
		output-high;
	};
};

&e16phy {
	clocks = <&clk_pcie E16PHY_PCLK_EN>, <&pcie_ref>;
	clock-names = "apb", "ref";
	data-lanes = <1 2 3 4>;

	status = "okay";
};

&pcie0 {
	num-lanes = <1>;
	pinctrl-0 = <&pcie0_clkreq_pins>;
	pinctrl-names = "default";
	reset-gpios = <&aw9535_1 0 GPIO_ACTIVE_LOW>;
	vpcie3v3-supply = <&reg_pcie_eth>;

	status = "okay";
};

&pcie1 {
	pinctrl-0 = <&pcie1_clkreq_pins>;
	pinctrl-names = "default";
	reset-gpios = <&aw9535_0 15 GPIO_ACTIVE_LOW>;
	vpcie1v5-supply = <&reg_minipcie_1v5>;
	vpcie3v3-supply = <&reg_minipcie_3v3>;

	status = "okay";
};

&sata {
	ports-implemented = <1>;

	status = "okay";
};

&power_sata {
	status = "okay";
};

&sata0 {
	target-supply = <&reg_m2_sata>;
};

&sata1 {
	status = "disabled";
};

&usb31_usb2_phy {
	status = "okay";
};

&usb3_phy {
	orientation-switch;

	status = "okay";

	port {
		usb3_ss: endpoint {
			remote-endpoint = <&usb_c_ss>;
		};
	};
};

&usb3 {
	dr_mode = "otg";
	usb-role-switch;

	status = "okay";

	port {
		usb3_role: endpoint {
			remote-endpoint = <&usb_c_hs>;
		};
	};
};

&aoi2c1 {
	typec@22 {
		compatible = "fcs,fusb302";
		reg = <0x22>;
		interrupt-parent = <&ao_gpio0>;
		interrupts = <28 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&usb_c_irq_pins>;
		pinctrl-names = "default";
		vbus-supply = <&reg_usb_c>;

		connector {
			compatible = "usb-c-connector";
			data-role = "dual";
			label = "USB-C";
			op-sink-microwatt = <1000000>;
			power-role = "dual";
			sink-pdos = <PDO_FIXED(5000, 1000, PDO_FIXED_USB_COMM)>;
			source-pdos = <PDO_FIXED(5000, 3000,
				      PDO_FIXED_USB_COMM)>;
			try-power-role = "sink";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					usb_c_hs: endpoint {
						remote-endpoint = <&usb3_role>;
					};
				};

				port@1 {
					reg = <1>;

					usb_c_ss: endpoint {
						remote-endpoint = <&usb3_ss>;
					};
				};
			};
		};
	};
};

&aon_padctrl {
	bt_enable_pins: bt-enable-0 {
		gpio-pins {
			bias-disable;
			drive-strength = <7>;
			input-disable;
			pins = "AOGPIO1_4";
		};
	};

	usb_c_irq_pins: usb-c-irq-0 {
		irq-pins {
			bias-pull-up;
			input-enable;
			input-schmitt-enable;
			pins = "AOGPIO0_28";
		};
	};
};

&sdio {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	max-frequency = <196608000>;
	mmc-pwrseq = <&wifi_pwrseq>;
	no-mmc;
	no-sd;
	non-removable;
	pinctrl-0 = <&sdio_pins>;
	pinctrl-names = "default";
	sd-uhs-sdr104;
	vmmc-supply = <&reg_wifi_3v3>;
	vqmmc-supply = <&reg_wifi_1v8>;

	status = "okay";
};

&uart5 {
	uart-has-rtscts;

	status = "okay";

	bluetooth {
		compatible = "realtek,rtl8822cs-bt";
		device-wake-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
		enable-gpios = <&ao_gpio1 4 GPIO_ACTIVE_HIGH>;
		host-wake-gpios = <&ao_gpio0 30 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&bt_enable_pins>, <&bt_wake_pins>;
		pinctrl-names = "default";
	};
};
