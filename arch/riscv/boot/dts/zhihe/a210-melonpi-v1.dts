/dts-v1/;

#include "a210-melonpi-common.dtsi"

/ {
	compatible = "zhihe,a210-melonpi-v1", "zhihe,a210-som", "zhihe,a210";
	model = "Melon Pi V1";

	pcie_osc: pcie-oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	pcie_ref: pcie-reference-clock {
		compatible = "gpio-gate-clock";
		#clock-cells = <0>;
		clocks = <&pcie_osc>;
		enable-gpios = <&aw9535_1 13 GPIO_ACTIVE_HIGH>;
	};

	regulator-fan {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_0 2 GPIO_ACTIVE_HIGH>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "fan-5v";
	};

	reg_pcie_3v3: regulator-pcie-3v3 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_1 6 GPIO_ACTIVE_HIGH>;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "pcie-3v3";
		startup-delay-us = <100000>;
		vin-supply = <&vdd_3v3>;
	};

	reg_pcie_12v: regulator-pcie-12v {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_1 7 GPIO_ACTIVE_HIGH>;
		regulator-max-microvolt = <12000000>;
		regulator-min-microvolt = <12000000>;
		regulator-name = "pcie-12v";
		startup-delay-us = <100000>;
	};

	regulator-pcie-aux {
		/*
		 * WAKE# shares CHIP_ID1; keep AUX off without a wake consumer.
		 */
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_1 10 GPIO_ACTIVE_HIGH>;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "pcie-3v3-aux";
	};
};

&aw9535_0 {
	/* U35 routes the shared pins to PCIe, leaving I2S0 disconnected. */
	pcie-sideband-select-hog {
		gpio-hog;
		gpios = <15 GPIO_ACTIVE_HIGH>;
		line-name = "pcie-sideband-select";
		output-low;
	};

	/* Keep the V1 clock control asserted across supply cycles. */
	sit91211-ssc-enable-hog {
		gpio-hog;
		gpios = <12 GPIO_ACTIVE_HIGH>;
		line-name = "sit91211-ssc-enable";
		output-high;
	};
};

&gpio0 {
	/* The x4 link needs PHY1's clock without the x1 controller. */
	pcie-ref1-request-hog {
		gpio-hog;
		gpios = <25 GPIO_ACTIVE_LOW>;
		line-name = "pcie-ref1-request";
		output-high;
	};

	/* The dedicated WAKE function is an output for endpoint mode. */
	pcie-wake-hog {
		gpio-hog;
		gpios = <31 GPIO_ACTIVE_LOW>;
		input;
		line-name = "pcie-wake-input";
	};
};

&peri1_padctrl {
	/* The host driver selects GPIO mode when it acquires PERST#. */
	pcie_reset_pins: pcie-reset-0 {
		gpio-pins {
			bias-disable;
			drive-strength = <7>;
			input-disable;
			pins = "GPIO0_30";
		};
	};

	pcie_sideband_pins: pcie-sideband-0 {
		/* BTN_RSTN reaches only TP41 through U35. */
		button-reset-pins {
			bias-pull-up;
			drive-strength = <7>;
			function = "pcie_x4";
			input-enable;
			input-schmitt-enable;
			pins = "GPIO0_28";
			slew-rate = <0>;
		};

		clkreq-pins {
			bias-disable;
			drive-strength = <7>;
			function = "pcie_x4";
			input-enable;
			input-schmitt-enable;
			pins = "GPIO0_29";
			slew-rate = <0>;
		};

		wake-pins {
			bias-disable;
			drive-strength = <7>;
			function = "gpio0";
			input-enable;
			input-schmitt-enable;
			pins = "GPIO0_31";
			slew-rate = <0>;
		};
	};
};

&e16phy {
	clocks = <&clk_pcie E16PHY_PCLK_EN>, <&pcie_ref>;
	clock-names = "apb", "ref";
	data-lanes = <1 1 1 1>;

	status = "okay";
};

&pcie0 {
	num-lanes = <4>;
	pinctrl-0 = <&pcie_reset_pins &pcie_sideband_pins>;
	pinctrl-names = "default";
	reset-gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
	vpcie3v3-supply = <&reg_pcie_3v3>;
	vpcie12v-supply = <&reg_pcie_12v>;

	status = "okay";
};

&sdio {
	bus-width = <4>;
	pinctrl-0 = <&sdio_pins>;
	pinctrl-names = "default";

	status = "disabled";
};
