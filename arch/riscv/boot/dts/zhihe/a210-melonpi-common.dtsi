#include "a210-som.dtsi"

/ {
	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		serial8 = &uart8;
		serial9 = &uart9;
	};

	chosen {
		stdout-path = "serial4:115200n8";
	};
};

&peri2_padctrl {
	status = "okay";

	uart4_pins: uart4-0 {
		rx-pins {
			bias-disable;
			drive-strength = <1>;
			function = "uart4";
			input-enable;
			input-schmitt-enable;
			pins = "GPIO2_1";
			slew-rate = <0>;
		};

		tx-pins {
			bias-disable;
			drive-strength = <3>;
			function = "uart4";
			input-disable;
			input-schmitt-disable;
			pins = "GPIO2_0";
			slew-rate = <0>;
		};
	};
};

&uart4 {
	pinctrl-0 = <&uart4_pins>;
	pinctrl-names = "default";

	status = "okay";
};
