#include "a210-som.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	aliases {
		mmc1 = &sdio;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		serial8 = &uart8;
		serial9 = &uart9;
	};

	chosen {
		stdout-path = "serial4:115200n8";
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out>;
			};
		};
	};

	vdd_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-max-microvolt = <1800000>;
		regulator-min-microvolt = <1800000>;
		regulator-name = "vdd-1v8";
		vin-supply = <&vdd_3v3>;
	};

	vdd_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&ao_gpio0 26 GPIO_ACTIVE_HIGH>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "vdd-3v3";
	};

	reg_usb_host: regulator-usb-host {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&aw9535_1 8 GPIO_ACTIVE_HIGH>;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "usb-host-vbus";
		startup-delay-us = <10000>;
	};
};

&peri2_padctrl {
	status = "okay";

	hdmi_pins: hdmi-0 {
		hdmi-pins {
			bias-disable;
			drive-strength = <3>;
			function = "hdmi";
			input-enable;
			input-schmitt-disable;
			pins = "GPIO2_25", "GPIO2_30", "GPIO2_31";
			slew-rate = <0>;
		};
	};

	i2c4_pins: i2c4-0 {
		bus-pins {
			bias-disable;
			drive-strength = <25>;
			function = "i2c4";
			input-enable;
			input-schmitt-enable;
			pins = "GPIO2_26", "GPIO2_27";
			slew-rate = <1>;
		};
	};

	uart4_pins: uart4-0 {
		rx-pins {
			bias-disable;
			drive-strength = <1>;
			function = "uart4";
			input-enable;
			input-schmitt-enable;
			pins = "GPIO2_1";
			slew-rate = <0>;
		};

		tx-pins {
			bias-disable;
			drive-strength = <3>;
			function = "uart4";
			input-disable;
			input-schmitt-disable;
			pins = "GPIO2_0";
			slew-rate = <0>;
		};
	};

	uart5_pins: uart5-1 {
		rx-pins {
			bias-disable;
			drive-strength = <1>;
			function = "uart5";
			input-enable;
			input-schmitt-enable;
			pins = "GPIO2_19", "GPIO3_9";
			slew-rate = <0>;
		};

		tx-pins {
			bias-disable;
			drive-strength = <3>;
			function = "uart5";
			input-disable;
			input-schmitt-disable;
			pins = "GPIO2_18", "GPIO3_10";
			slew-rate = <0>;
		};
	};
};

&uart4 {
	pinctrl-0 = <&uart4_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&ao_gpio0 {
	power-5v-en-hog {
		gpio-hog;
		gpios = <29 GPIO_ACTIVE_HIGH>;
		line-name = "power_5v_en";
		output-high;
	};
};

&aon_padctrl {
	status = "okay";

	aoi2c1_pins: aoi2c1-0 {
		bus-pins {
			bias-disable;
			drive-strength = <25>;
			function = "aoi2c1";
			input-enable;
			input-schmitt-enable;
			pins = "AOI2C1_SCL", "AOI2C1_SDA";
			slew-rate = <1>;
		};
	};
};

&aoi2c1 {
	clock-frequency = <100000>;
	pinctrl-0 = <&aoi2c1_pins>;
	pinctrl-names = "default";

	status = "okay";

	aw9535_0: gpio@20 {
		compatible = "awinic,aw9535";
		reg = <0x20>;
		#gpio-cells = <2>;
		gpio-controller;
		vcc-supply = <&vdd_1v8>;
	};

	aw9535_1: gpio@21 {
		compatible = "awinic,aw9535";
		reg = <0x21>;
		#gpio-cells = <2>;
		gpio-controller;
		vcc-supply = <&vdd_1v8>;
	};
};

&aw9535_1 {
	download-vbus-off-hog {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>;
		line-name = "download-vbus-off";
		output-low;
	};
};

&i2c4 {
	clock-frequency = <400000>;
	pinctrl-0 = <&i2c4_pins>;
	pinctrl-names = "default";

	status = "okay";

	rtc: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		#clock-cells = <0>;
	};
};

&peri1_padctrl {
	status = "okay";
};

&peri3_padctrl {
	status = "okay";

	sdio_pins: sdio-0 {
		clock-pins {
			bias-disable;
			pins = "SDIO_CLK";
		};

		data-pins {
			bias-pull-up;
			pins = "SDIO_CMD", "SDIO_DAT0", "SDIO_DAT1",
			       "SDIO_DAT2", "SDIO_DAT3";
		};

		sdio-pins {
			function = "sdio";
			groups = "sdio";
		};
	};
};

&usb2_phy0 {
	status = "okay";
};

&usb2_phy1 {
	status = "okay";
};

&usb2_0 {
	dr_mode = "peripheral";

	status = "okay";
};

&usb2_1 {
	dr_mode = "host";
	vbus-supply = <&reg_usb_host>;

	status = "okay";
};

&uart5 {
	pinctrl-0 = <&uart5_pins>;
	pinctrl-names = "default";
};

&dc8200 {
	status = "okay";
};

&hdmi {
	pinctrl-0 = <&hdmi_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&hdmi_out {
	remote-endpoint = <&hdmi_con_in>;
};
