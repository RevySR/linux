#include "a210.dtsi"

/ {
	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		mmc0 = &emmc;
	};

	reg_vref_1v8: regulator-adc-vref {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <1800000>;
		regulator-min-microvolt = <1800000>;
		regulator-name = "vref-1v8";
	};

	reserved-memory {
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0x80000000 0 0x80000000>;
			reusable;
			size = <0 0x10000000>;
			linux,cma-default;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x1 0x0>;
	};
};

&mbox_e902 {
	status = "okay";
};

&scmi {
	status = "okay";
};

&scmi_voltage {
	regulators {
		#address-cells = <1>;
		#size-cells = <0>;

		dvdd_cpu_reg: regulator@0 {
			reg = <0>;
			regulator-always-on;
			regulator-max-microvolt = <1000000>;
			regulator-min-microvolt = <600000>;
			regulator-name = "dvdd_cpu";
		};

		dvddm_cpu_reg: regulator@1 {
			reg = <1>;
			regulator-always-on;
			regulator-max-microvolt = <1000000>;
			regulator-min-microvolt = <800000>;
			regulator-name = "dvddm_cpu";
		};

		dvdd_cpu_p_reg: regulator@2 {
			reg = <2>;
			regulator-always-on;
			regulator-max-microvolt = <1000000>;
			regulator-min-microvolt = <800000>;
			regulator-name = "dvdd_cpu_p";
		};

		dvdd08_ddr_reg: regulator@3 {
			reg = <3>;
			regulator-always-on;
			regulator-max-microvolt = <800000>;
			regulator-min-microvolt = <750000>;
			regulator-name = "dvdd08_ddr";
		};

		dvdd_vp_reg: regulator@4 {
			reg = <4>;
			regulator-max-microvolt = <800000>;
			regulator-min-microvolt = <750000>;
			regulator-name = "dvdd_vp";
		};

		dvdd_npu_vip_reg: regulator@5 {
			reg = <5>;
			regulator-max-microvolt = <1000000>;
			regulator-min-microvolt = <750000>;
			regulator-name = "dvdd_npu_vip";
		};

		dvdd_gpu_reg: regulator@6 {
			reg = <6>;
			regulator-max-microvolt = <800000>;
			regulator-min-microvolt = <750000>;
			regulator-name = "dvdd_gpu";
		};

		avdd33_emmc_reg: regulator@7 {
			reg = <7>;
			regulator-always-on;
			regulator-name = "avdd33_emmc";
		};

		avdd33_usb2_reg: regulator@8 {
			reg = <8>;
			regulator-always-on;
			regulator-name = "avdd33_usb2";
		};

		dvdd08_aon_reg: regulator@9 {
			reg = <9>;
			regulator-always-on;
			regulator-name = "dvdd08_aon";
		};

		avdd18_aon_reg: regulator@a {
			reg = <10>;
			regulator-always-on;
			regulator-name = "avdd18_aon";
		};

		avdd18_emmc_usb2_reg: regulator@b {
			reg = <11>;
			regulator-always-on;
			regulator-name = "avdd18_emmc_usb2";
		};

		avdd18_emmc_peri_reg: regulator@c {
			reg = <12>;
			regulator-always-on;
			regulator-name = "avdd18_emmc_peri";
		};

		avdd18_top_reg: regulator@d {
			reg = <13>;
			regulator-always-on;
			regulator-name = "avdd18_top";
		};

		avdd18_pll_reg: regulator@e {
			reg = <14>;
			regulator-always-on;
			regulator-name = "avdd18_pll";
		};

		avdd18_reg: regulator@f {
			reg = <15>;
			regulator-always-on;
			regulator-name = "avdd18";
		};

		dvdd18_ddr_vaa_reg: regulator@10 {
			reg = <16>;
			regulator-always-on;
			regulator-name = "dvdd18_ddr_vaa";
		};

		p3v3_reg: regulator@11 {
			reg = <17>;
			regulator-always-on;
			regulator-name = "p3v3";
		};

		dvdd08_top_reg: regulator@12 {
			reg = <18>;
			regulator-always-on;
			regulator-name = "dvdd08_top";
		};

		dvdd06_ddr_vddqlp_reg: regulator@13 {
			reg = <19>;
			regulator-always-on;
			regulator-name = "dvdd06_ddr_vddqlp";
		};
	};
};

&emmc {
	assigned-clock-parents = <&clk AUDIO0_PLL_FOUTVCO>, <0>;
	assigned-clock-rates = <0>, <786432000>;
	assigned-clocks = <&clk TOP_PERI_EMMC_REF_CLK_MUX>,
			  <&clk TOP_PERI_EMMC_REF_CLK_DIV>;
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <196608000>;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	no-sd;
	no-sdio;
	non-removable;

	status = "okay";
};

&gmac0 {
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	pinctrl-0 = <&gmac0_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&gmac1 {
	phy-handle = <&phy1>;
	phy-mode = "rgmii-id";
	pinctrl-0 = <&gmac1_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&mdio0 {
	phy0: ethernet-phy@0 {
		reg = <0x0>;
	};
};

&mdio1 {
	phy1: ethernet-phy@0 {
		reg = <0x0>;
	};
};

&peri1_padctrl {
	gmac0_pins: gmac0-0 {
		rx-pins {
			bias-disable;
			drive-strength = <13>;
			function = "gmac0";
			input-enable;
			input-schmitt-disable;
			pins = "GPIO0_1",  /* GMAC0_RX_CLK */
			       "GPIO0_7",  /* GMAC0_RXDV */
			       "GPIO0_8",  /* GMAC0_RXD0 */
			       "GPIO0_9",  /* GMAC0_RXD1 */
			       "GPIO0_10", /* GMAC0_RXD2 */
			       "GPIO0_11", /* GMAC0_RXD3 */
			       "GPIO0_13"; /* GMAC0_MDIO */
			slew-rate = <0>;
		};

		tx-pins {
			bias-disable;
			drive-strength = <20>;
			function = "gmac0";
			input-disable;
			input-schmitt-disable;
			pins = "GPIO0_2", /* GMAC0_TXEN */
			       "GPIO0_3", /* GMAC0_TXD0 */
			       "GPIO0_4", /* GMAC0_TXD1 */
			       "GPIO0_5", /* GMAC0_TXD2 */
			       "GPIO0_6"; /* GMAC0_TXD3 */
			slew-rate = <0>;
		};

		txclk-pins {
			bias-disable;
			drive-strength = <13>;
			function = "gmac0";
			input-disable;
			input-schmitt-disable;
			pins = "GPIO0_0", /* GMAC0_TX_CLK */
			       "GPIO0_12"; /* GMAC0_MDC */
			slew-rate = <0>;
		};
	};

	gmac1_pins: gmac1-0 {
		rx-pins {
			bias-disable;
			drive-strength = <13>;
			function = "gmac1";
			input-enable;
			input-schmitt-disable;
			pins = "GPIO1_3",  /* GMAC1_RX_CLK */
			       "GPIO1_9",  /* GMAC1_RXDV */
			       "GPIO1_10",  /* GMAC1_RXD0 */
			       "GPIO1_11",  /* GMAC1_RXD1 */
			       "GPIO1_12", /* GMAC1_RXD2 */
			       "GPIO1_13", /* GMAC1_RXD3 */
			       "GPIO1_15"; /* GMAC1_MDIO */
			slew-rate = <0>;
		};

		tx-pins {
			bias-disable;
			drive-strength = <20>;
			function = "gmac1";
			input-disable;
			input-schmitt-disable;
			pins = "GPIO1_4", /* GMAC1_TXEN */
			       "GPIO1_5", /* GMAC1_TXD0 */
			       "GPIO1_6", /* GMAC1_TXD1 */
			       "GPIO1_7", /* GMAC1_TXD2 */
			       "GPIO1_8"; /* GMAC1_TXD3 */
			slew-rate = <0>;
		};

		txclk-pins {
			bias-disable;
			drive-strength = <13>;
			function = "gmac1";
			input-disable;
			input-schmitt-disable;
			pins = "GPIO1_2", /* GMAC1_TX_CLK */
			       "GPIO1_14"; /* GMAC1_MDC */
			slew-rate = <0>;
		};
	};
};

&power_gpu {
	pmic-supply = <&dvdd_gpu_reg>;
};

&clk {
	assigned-clock-rates = <2359296000>, <2528870400>;
	assigned-clocks = <&clk AUDIO0_PLL_FOUTVCO>, <&clk AUDIO1_PLL_FOUTVCO>;
};

&adc {
	vref-supply = <&reg_vref_1v8>;

	status = "okay";
};
